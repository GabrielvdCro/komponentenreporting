# ============================================================
# HILFSFUNKTIONEN
# ============================================================

def titel(text):
    print("\n" + "=" * 60)
    print(text)
    print("=" * 60)


def sql_laden(datei):
    """Liest eine SQL-Datei ein."""
    return datei.read_text(encoding="utf-8")


def sql_ausfuehren(con, datei):
    """Führt eine SQL-Datei aus."""
    print(f"SQL wird ausgeführt: {datei.name}")
    con.execute(sql_laden(datei))
    print("OK")


def python_ausfuehren(datei):
    """Führt ein externes Python-Skript aus."""
    print(f"Python wird ausgeführt: {datei.name}")

    subprocess.run(
        [sys.executable, str(datei)],
        check=True
    )

    print("OK")


# ============================================================
# DATUMSWERTE DER AKTUELLEN QUELLDATEIEN ERMITTELN
# ============================================================

def planungsdaten_ermitteln(con):
    """
    Liest alle extraction_date-Werte aus Spalte extraction_date
    der aktuell im Planungsordner vorhandenen CSV-Dateien.
    """

    dateien = list(ORDNER_PLANUNG.glob("*.csv"))

    daten = set()

    for datei in dateien:

        result = con.execute(
            """
            SELECT DISTINCT
                TRY_CAST("extraction_date" AS DATE)
            FROM read_csv_auto(?)
            WHERE TRY_CAST("extraction_date" AS DATE) IS NOT NULL
            """,
            [str(datei)]
        ).fetchall()

        daten.update(row[0] for row in result)

    return daten


def buchungsdaten_ermitteln(con, ordner):
    """
    Liest alle Buchungsdatum-Werte aus den aktuell vorhandenen
    CSV-Dateien eines Ordners.
    """

    dateien = list(ordner.glob("*.csv"))

    daten = set()

    for datei in dateien:

        result = con.execute(
            """
            SELECT DISTINCT
                TRY_CAST("Buchungsdatum" AS DATE)
            FROM read_csv_auto(?)
            WHERE TRY_CAST("Buchungsdatum" AS DATE) IS NOT NULL
            """,
            [str(datei)]
        ).fetchall()

        daten.update(row[0] for row in result)

    return daten


# ============================================================
# ROLLBACK
# ============================================================

def rollback(con):

    titel("ROLLBACK WIRD DURCHGEFÜHRT")

    # --------------------------------------------------------
    # Datumswerte der aktuellen Quelldateien bestimmen
    # --------------------------------------------------------

    planungsdaten = planungsdaten_ermitteln(con)

    eingangsdaten = buchungsdaten_ermitteln(
        con,
        ORDNER_WARENEINGANG
    )

    ausgangsdaten = buchungsdaten_ermitteln(
        con,
        ORDNER_WARENAUSGANG
    )


    # --------------------------------------------------------
    # Planung zurücksetzen
    # --------------------------------------------------------

    print("Planungsdaten werden zurückgesetzt...")

    for datum in planungsdaten:

        con.execute(
            """
            DELETE FROM bronze.sap_planung
            WHERE "Extraktiondatum" = ?
            """,
            [datum]
        )


    # --------------------------------------------------------
    # Wareneingang zurücksetzen
    # --------------------------------------------------------

    print("Wareneingänge werden zurückgesetzt...")

    for datum in eingangsdaten:

        con.execute(
            """
            DELETE FROM bronze.sap_materialeingang
            WHERE TRY_CAST("Buchungsdatum" AS DATE) = ?
            """,
            [datum]
        )


    # --------------------------------------------------------
    # Warenausgang zurücksetzen
    # --------------------------------------------------------

    print("Warenausgänge werden zurückgesetzt...")

    for datum in ausgangsdaten:

        con.execute(
            """
            DELETE FROM bronze.sap_materialausgang
            WHERE TRY_CAST("Buchungsdatum" AS DATE) = ?
            """,
            [datum]
        )


    # --------------------------------------------------------
    # Bronze-Referenztabellen komplett leeren
    # --------------------------------------------------------

    print("Bronze-Referenztabellen werden geleert...")

    bronze_referenzen = [
        "bronze.ref_artikelliste",
        "bronze.ref_taktmenge",
        "bronze.ref_kalender",
        "bronze.ref_flottenliste",
        "bronze.ref_stueckliste"
    ]

    for tabelle in bronze_referenzen:
        con.execute(f"TRUNCATE TABLE {tabelle}")


    # --------------------------------------------------------
    # Silver komplett leeren
    # --------------------------------------------------------

    print("Silver-Layer wird geleert...")

    silver_tabellen = [
        "silver.sap_planung",
        "silver.sap_materialeingang",
        "silver.sap_materialausgang",
        "silver.ref_artikelliste",
        "silver.ref_takt",
        "silver.ref_kalender",
        "silver.ref_flottenliste",
        "silver.ref_stueckliste"
    ]

    for tabelle in silver_tabellen:
        con.execute(f"TRUNCATE TABLE {tabelle}")


    # --------------------------------------------------------
    # Gold-Views entfernen
    # --------------------------------------------------------

    print("Gold-Views werden entfernt...")

    gold_views = [
        "gold.dim_artikelliste",
        "gold.fact_planung",
        "gold.fact_reparaturen",
        "gold.fact_materialeingang"
    ]

    for view in gold_views:
        con.execute(f"DROP VIEW IF EXISTS {view}")


    titel("ROLLBACK ABGESCHLOSSEN")

    print("Quelldateien korrigieren und Pipeline erneut starten.")


# ============================================================
# BRONZE VALIDIEREN
# ============================================================

def bronze_validieren(con):

    titel("BRONZE VALIDIEREN")

    sql = sql_laden(SQL_VALIDIERUNG_BRONZE)

    result = con.execute(sql).fetchdf()

    print(result.to_string(index=False))

    fehler = result[
        result["anzahl_datensaetze"] == 0
    ]

    if not fehler.empty:

        print("\nFEHLER:")
        print("Mindestens eine Bronze-Tabelle enthält keine Daten.")

        print("\nBetroffene Tabellen:")
        print(fehler.to_string(index=False))

        return False

    print("\nBronze-Validierung erfolgreich.")

    return True


# ============================================================
# SILVER VALIDIEREN
# ============================================================

def silver_validieren(con):

    titel("SILVER VALIDIEREN")

    sql = sql_laden(SQL_VALIDIERUNG_SILVER)

    result = con.execute(sql).fetchdf()

    if not result.empty:

        print("FEHLER IN SILVER:\n")

        print(result.to_string(index=False))

        print(
            f"\nAnzahl gefundener Fehler: {len(result)}"
        )

        return False

    print("Keine Fehler gefunden.")
    print("Silver-Validierung erfolgreich.")

    return True


