        # ----------------------------------------------------
        # Verbindung MotherDuck
        # ----------------------------------------------------

        titel("VERBINDUNG ZU MOTHERDUCK")

        con = duckdb.connect(DATENBANK)

        print("Verbindung erfolgreich.")


        # ----------------------------------------------------
        # 2. Schema erstellen
        # ----------------------------------------------------

        titel("2. SCHEMA ERSTELLEN")

        sql_ausfuehren(
            con,
            SQL_SCHEMA
        )


        # ----------------------------------------------------
        # 3. Bronze erstellen
        # ----------------------------------------------------

        titel("3. BRONZE ERSTELLEN")

        sql_ausfuehren(
            con,
            SQL_BRONZE
        )


        # ----------------------------------------------------
        # 4. Bronze laden
        # ----------------------------------------------------

        titel("4. BRONZE LADEN")

        sql_ausfuehren(
            con,
            SQL_UPLOAD_BRONZE
        )


        # ----------------------------------------------------
        # 5. Bronze validieren
        # ----------------------------------------------------

        if not bronze_validieren(con):

            rollback(con)
            return


        # ----------------------------------------------------
        # 6. Silver erstellen
        # ----------------------------------------------------

        titel("6. SILVER ERSTELLEN")

        sql_ausfuehren(
            con,
            SQL_SILVER
        )


        # ----------------------------------------------------
        # 7. Silver laden
        # ----------------------------------------------------

        titel("7. SILVER LADEN")

        sql_ausfuehren(
            con,
            SQL_UPLOAD_SILVER
        )


        # ----------------------------------------------------
        # 8. Silver validieren
        # ----------------------------------------------------

        if not silver_validieren(con):

            rollback(con)
            return


        # ----------------------------------------------------
        # 9. Gold erstellen
        # ----------------------------------------------------

        titel("9. GOLD ERSTELLEN")

        sql_ausfuehren(
            con,
            SQL_GOLD
        )


        # ----------------------------------------------------
        # Fertig
        # ----------------------------------------------------

        titel("PIPELINE ERFOLGREICH ABGESCHLOSSEN")

        print("Gold steht bereit für weitere Analysen")


    # ========================================================
    # Unerwarteter technischer Fehler
    # ========================================================

    except Exception as fehler:

        titel("PIPELINE ABGEBROCHEN")

        print("Es ist ein unerwarteter Fehler aufgetreten:")
        print(fehler)

        if con is not None:

            try:
                rollback(con)

            except Exception as rollback_fehler:

                print("\nACHTUNG:")
                print("Auch beim Rollback ist ein Fehler aufgetreten:")
                print(rollback_fehler)


    finally:

        if con is not None:
            con.close()


