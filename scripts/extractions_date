import pandas as pd
from pathlib import Path


# Ordner mit den Excel-Dateien
ordner = Path(
    r"C:\Users\u234530\OneDrive - SBB\Komponentenreporting\Inputdateien\Planung"
)


# Alle Excel-Dateien im Ordner durchgehen
for datei in ordner.glob("*.xlsx"):

    # Die ersten 10 Zeichen des Dateinamens als Datum nehmen
    datum = datei.stem[:10]

    # Tabelle A einlesen
    df = pd.read_excel(datei, sheet_name="Tabelle A")

    # Neue Spalte "extraction_date" hinzufügen und das Datum eintragen
    df["extraction_date"] = datum

    # Tabelle A in derselben Excel-Datei ersetzen
    with pd.ExcelWriter(
        datei,
        engine="openpyxl",
        mode="a",
        if_sheet_exists="replace"
    ) as writer:

        df.to_excel(
            writer,
            sheet_name="Tabelle A",
            index=False
        )

    # Meldung im Terminal
    print(f"Fertig: {datei.name} → {datum}")
