TRUNCATE TABLE silver.sap_planung;

INSERT INTO silver.sap_planung (
    "Artikel_ID",
    "Extraktiondatum",
    "Art",
    "Dispositionselement",
    "Bestell-/Auftragsart",
    "Nummer Dispositionselement",
    "Verursacher",
    "Zugang/Bedarf",
    "Plantermine"
)
SELECT
    CONCAT("Werk", '-', "Material") AS "Artikel_ID",
    CAST("extraktiondatum" AS DATE),

    CASE
        WHEN "Plus/minus" = '+' THEN 'Planbedarfe'
        WHEN "Plus/minus" = '-' THEN 'Bedarfe'
    END AS "Art",

    "Dispositionselement",
    "Bestell-/Auftragsart",
    "Nummer Dispositionselement",
    "Verursacher",
    "Zugang/Bedarf",
    LAST_DAY(CAST("Plantermine" AS DATE)) AS "Plantermine"

FROM bronze.sap_planung;


TRUNCATE TABLE silver.sap_materialeingang;

INSERT INTO silver.sap_materialeingang (
    "Artikel_ID",
    "Bewegungsart",
    "Buchungsdatum",
    "Menge in ErfassME",
    "Auftrag"
)
SELECT
    CONCAT("Werk", '-', "Material") AS "Artikel_ID",
    "Bewegungsart",
    LAST_DAY(CAST("Buchungsdatum" AS DATE)) AS "Buchungsdatum",
    "Menge in ErfassME",
    "Auftrag"

FROM bronze.sap_materialeingang

WHERE
    "Auftrag" LIKE '2%'
    OR "Auftrag" LIKE '3%'
    OR "Auftrag" LIKE '15%'
    OR "Auftrag" LIKE '16%'
    OR "Auftrag" LIKE '17%';


TRUNCATE TABLE silver.sap_materialausgang;

INSERT INTO silver.sap_materialausgang (
    "Artikel_ID",
    "Bewegungsart",
    "Buchungsdatum",
    "Menge in ErfassME",
    "Betrag Hauswähr",
    "Auftrag",
    "Warenempfänger"
)
SELECT
    CONCAT("Werk", '-', "Material") AS "Artikel_ID",
    "Bewegungsart",
    LAST_DAY(CAST("Buchungsdatum" AS DATE)) AS "Buchungsdatum",
    "Menge in ErfassME" * -1 AS "Menge in ErfassME",
    "Betrag Hauswähr",
    "Auftrag",

    CASE
        WHEN RIGHT("Warenempfänger", 4) LIKE '21%'
            THEN 'Reparatur'
        ELSE 'Revision'
    END AS "Warenempfänger"

FROM bronze.sap_materialausgang;


