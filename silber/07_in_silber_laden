TRUNCATE TABLE silver.ref_kalender;

INSERT INTO silver.ref_kalender (
    "Datum",
    "Arbeitstage Olten",
    "Arbeitstage Yverdon"
)
SELECT
    LAST_DAY("Datum") AS "Datum",
    SUM("AT Olten") AS "Arbeitstage Olten",
    SUM("AT Yverdon") AS "Arbeitstage Yverdon"

FROM bronze.ref_kalender

GROUP BY
    LAST_DAY("Datum")

ORDER BY
    "Datum";


TRUNCATE TABLE silver.ref_flottenliste;

INSERT INTO silver.ref_flottenliste (
    "Artikel_ID",
    "Ø Klimageräte FGR",
    "Ø Klimageräte FST",
    "Ø Alter",
    "Ø Anzahl KM Juli Stand Juli 2026"
)
SELECT
    CONCAT('2103-', "Artikel") AS "Artikel_ID",

    AVG("Anzahl Klimageräte FGR") AS "Ø Klimageräte FGR",

    AVG("Anzahl Klimageräte FST") AS "Ø Klimageräte FST",

    AVG(
        DATE_DIFF(
            'year',
            "Einführung",
            CURRENT_DATE
        )
    ) AS "Ø Alter",

    AVG("Anzahl KM Stand Juli 2026") AS "Ø Anzahl KM Juli Stand Juli 2026"

FROM bronze.ref_flottenliste

GROUP BY
    CONCAT('2103-', "Artikel");

TRUNCATE TABLE silver.ref_stueckliste;

INSERT INTO silver.ref_stueckliste (
    "Artikel_ID",
    "Anzahl Unterkomponenten",
    "Standardpreis total"
)
SELECT
    CONCAT(
        '2103-',
        REPLACE("hauptartikel", '.csv', '')
    ) AS "Artikel_ID",

    COUNT(*) AS "Anzahl Unterkomponenten",

    SUM(
        "Komponentenmenge"
        * "Einsatzwahrscheinlichkeit"
        * "Standardpreis"
    ) AS "Standardpreis total"

FROM bronze.ref_stueckliste

GROUP BY
    CONCAT(
        '2103-',
        REPLACE("hauptartikel", '.csv', '')
    );
