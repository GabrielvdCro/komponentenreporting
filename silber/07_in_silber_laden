TRUNCATE TABLE silver.ref_artikelliste;

INSERT INTO silver.ref_artikelliste (
    "Artikel_ID",
    "Werk",
    "Material",
    "Beschrieb",
    "Materialgruppe",
    "Fahrzeug"
)
SELECT
    CONCAT(a."Werk", '-', a."Material") AS "Artikel_ID",

    CASE
        WHEN a."Werk" = '2101' THEN 'Yverdon'
        WHEN a."Werk" = '2103' THEN 'Olten'
        WHEN a."Werk" = '2104' THEN 'Bellinzona'
        ELSE a."Werk"
    END AS "Werk",

    a."Material",
    a."Beschrieb",
    a."Materialgruppe",

    CASE
        WHEN a."Fahrzeug" IS NULL
             OR TRIM(a."Fahrzeug") = ''
